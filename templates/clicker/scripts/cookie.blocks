{
  "aven": "blocks",
  "version": 1,
  "variables": [],
  "scripts": [
    {
      "x": 20,
      "y": 20,
      "blocks": [
        {
          "type": "when_clicked"
        },
        {
          "type": "change_game",
          "inputs": {
            "name": "cookies",
