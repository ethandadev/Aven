              }
            }
          }
        },
        {
          "type": "play_sound",
          "inputs": {
            "sound": "sounds/click.wav"
          }
        },
        {
          "type": "emit",
          "inputs": {
            "count": 6
          }
        },
        {
          "type": "set_size",
          "inputs": {
            "size": 1.08
          }
        },
        {
          "type": "wait",
          "inputs": {
            "seconds": 0.06
          }
        },
        {
          "type": "set_size",
          "inputs": {
            "size": 1
          }
        }
      ]
    }
  ]
}
